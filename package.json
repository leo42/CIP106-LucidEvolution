{
  "name": "cip106-lucidevolution",
  "version": "0.1.0",
  "description": "CIP106 implementation for Lucid Evolution",
  "repository": "https://github.com/leo42/CIP106-LucidEvolution",
  "main": "dist/mod.js",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./lib/*": "./lib/*"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "^0.4.29",
    "events": "^3.3.0"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf node_modules && rm -rf lib",
    "prepublish": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "tsup": "^8.2.0",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "cardano",
    "lucid",
    "cip106"
  ],
  "author": "Leo",
  "license": "MIT"
}
